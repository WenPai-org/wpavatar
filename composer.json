{
  "name": "wenpai-org/wpavatar",
  "description": "Development tooling for WPAvatar",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
